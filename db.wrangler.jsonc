// For database commands only (migrations, execute, export); never deployed. Its default local
// state (.wrangler/state here at the repo root) is the folder both apps' dev servers share.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedback-db",
  // The mgbr1.fad Cloudflare account (FAD's office login). Same value in all three configs.
  "account_id": "e4fa12ea485dab2335b662d716736736",
  "compatibility_date": "2026-09-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback",
      // Must equal the id in apps/public/wrangler.jsonc and apps/admin/wrangler.jsonc (a test checks).
      "database_id": "347573b7-51c3-4716-893c-93e13847ecef",
      "migrations_dir": "migrations"
    }
  ]
}
