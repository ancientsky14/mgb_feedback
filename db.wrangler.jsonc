// For database commands only (migrations, execute, export); never deployed. Its default local
// state (.wrangler/state here at the repo root) is the folder both apps' dev servers share.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedback-db",
  // Ict1@mgb.gov.ph's Account (MGB ICT). FAD's member login also reaches FAD's own account, so this
  // pin is what keeps every command in the ICT account. Same value in all three configs.
  "account_id": "b299efc33bdc0c0dea89e9076f87586c",
  "compatibility_date": "2026-09-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback",
      // Must equal the id in apps/public/wrangler.jsonc and apps/admin/wrangler.jsonc (a test checks).
      "database_id": "1088eb82-633b-440f-8499-7e1dea9226df",
      "migrations_dir": "migrations"
    }
  ]
}
