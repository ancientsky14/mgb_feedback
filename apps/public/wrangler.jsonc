// The public side: the QR survey form and the three endpoints it calls. It holds no admin
// code at all — that lives in apps/admin, a separate Worker behind Cloudflare Access.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Served at https://feedback.mgbr1-fad.workers.dev (the mgbr1.fad account's workers.dev subdomain).
  "name": "feedback",
  // The mgbr1.fad Cloudflare account (FAD's office login). Same value in all three configs.
  "account_id": "e4fa12ea485dab2335b662d716736736",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": { "enabled": true },
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback",
      // Same database as apps/admin and db.wrangler.jsonc (mgbr1.fad account, APAC).
      "database_id": "347573b7-51c3-4716-893c-93e13847ecef",
      "migrations_dir": "../../migrations"
    }
  ],
  // Flood brake only (windows are 10 or 60 s, counted per Cloudflare location). Hourly caps
  // live in D1. Kept generous: every client on the office Wi-Fi shares one address.
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "7101", "simple": { "limit": 20, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "7102", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "OFFICE_NAME": "Mines and Geosciences Bureau Regional Office No. I",
    // The production Turnstile widget (mgbr1.fad account). Public by design: every browser
    // receives it. Local development overrides it with Cloudflare's test key in .dev.vars.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFAvsuFdzLRbT7Nw",
    // Siteverify results from any other host are refused. Must be one of the widget's hostnames.
    "TURNSTILE_EXPECTED_HOSTNAME": "feedback.mgbr1-fad.workers.dev"
  }
  // Secrets (never in this file): TURNSTILE_SECRET_KEY, IP_HASH_SECRET — see DEPLOYMENT.md.
}
