// The public side: the QR survey form and the three endpoints it calls. It holds no admin
// code at all — that lives in apps/admin, a separate Worker behind Cloudflare Access.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mgbr1-feedback-public",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": { "enabled": true },
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback",
      // Same database as apps/admin. Replace with the id from `wrangler d1 create feedback` (DEPLOYMENT.md).
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  // Flood brake only (windows are 10 or 60 s, counted per Cloudflare location). Hourly caps
  // live in D1. Kept generous: every client on the office Wi-Fi shares one address.
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "7101", "simple": { "limit": 20, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "7102", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "OFFICE_NAME": "Mines and Geosciences Bureau Regional Office No. I",
    // Cloudflare's always-pass test site key. Replace with the production key before deploying.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Set to the production hostname so Siteverify results from any other host are refused.
    "TURNSTILE_EXPECTED_HOSTNAME": ""
  }
  // Secrets (never in this file): TURNSTILE_SECRET_KEY, IP_HASH_SECRET — see DEPLOYMENT.md.
}
