// The public side: the QR survey form and the three endpoints it calls. It holds no admin
// code at all — that lives in apps/admin, a separate Worker behind Cloudflare Access.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Served only at https://feedback.onemgb.com, the address printed in every QR code.
  "name": "feedback",
  // Ict1@mgb.gov.ph's Account (MGB ICT). FAD's member login also reaches FAD's own account, so this
  // pin is what keeps every command in the ICT account. Same value in all three configs.
  "account_id": "b299efc33bdc0c0dea89e9076f87586c",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": { "enabled": true },
  "preview_urls": false,
  // One address only: a workers.dev copy would be a second survey Turnstile refuses to verify.
  "workers_dev": false,
  // A Custom Domain: the Worker is the origin; Cloudflare creates the DNS record and certificate.
  // Must equal vars.TURNSTILE_EXPECTED_HOSTNAME (a test and scripts/predeploy-check.mjs check).
  "routes": [{ "pattern": "feedback.onemgb.com", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback",
      // Same database as apps/admin and db.wrangler.jsonc (ICT account, APAC).
      "database_id": "1088eb82-633b-440f-8499-7e1dea9226df",
      "migrations_dir": "../../migrations"
    }
  ],
  // Flood brake only (windows are 10 or 60 s, counted per Cloudflare location). Hourly caps
  // live in D1. Kept generous: every client on the office Wi-Fi shares one address.
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "7101", "simple": { "limit": 20, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "7102", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "OFFICE_NAME": "Mines and Geosciences Bureau Regional Office No. I",
    // The Turnstile widget in the MGB ICT account, for feedback.onemgb.com. Public by design:
    // every browser receives it. Local development overrides it with Cloudflare's test key in
    // .dev.vars.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFB2I7nJe5LX8DM1",
    // Siteverify results from any other host are refused. Must be the custom domain above and
    // one of the widget's hostnames.
    "TURNSTILE_EXPECTED_HOSTNAME": "feedback.onemgb.com"
  }
  // Secrets (never in this file): TURNSTILE_SECRET_KEY, IP_HASH_SECRET — see DEPLOYMENT.md.
}
