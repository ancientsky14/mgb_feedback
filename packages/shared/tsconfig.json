{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  // Tests that read files from disk run under Node types in tsconfig.node.json; the shared
